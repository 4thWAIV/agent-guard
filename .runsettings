<?xml version="1.0" encoding="utf-8"?>
<!--
  Zero-effort code-coverage collection (decision zero-effort-collection). Directory.Build.props points every
  `dotnet test` at this file through RunSettingsFilePath, so coverage is collected on every run with no extra
  flags. coverlet.collector writes one cobertura report per test project; CI merges them and gates the aggregate
  and each per-OS implementation at 75% (decisions threshold-75-hard-gate, covered-assemblies).

  The counted set is exactly the product assemblies (Include). AgentGuard.Cli builds as `guard.dll`, so its
  assembly name is `guard`. AgentGuard.Analyzers and every *.Tests assembly are excluded, so they are absent from
  the coverage number (decision covered-assemblies).
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[AgentGuard.Engine]*,[guard]*,[AgentGuard.CrossPlatform]*,[AgentGuard.CrossPlatform.MacOS]*,[AgentGuard.CrossPlatform.Linux]*,[AgentGuard.CrossPlatform.Windows]*</Include>
          <Exclude>[AgentGuard.Analyzers]*,[*.Tests]*</Exclude>
          <SkipAutoProps>true</SkipAutoProps>
          <UseSourceLink>false</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>

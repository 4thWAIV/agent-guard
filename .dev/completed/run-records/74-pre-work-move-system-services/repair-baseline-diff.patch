+    /// <summary>
+    /// Throws when <paramref name="compilation"/> has any compiler error, naming every one of them. A fixture the
+    /// compiler rejects yields no analyzer diagnostics, so an accept case asserting none would pass whether the
+    /// analyzer stayed quiet or the code never compiled. The inaccessibility error (CS0122) is the one that bites:
+    /// a fixture reaching an internal member of a referenced fake assembly without an InternalsVisibleTo grant
+    /// looks exactly like a clean accept.
+    /// </summary>
+    /// <param name="compilation">The compilation to check.</param>
+    /// <param name="assemblyName">The assembly name to name in the failure message.</param>
+    private static void ThrowOnCompilerErrors(Compilation compilation, string assemblyName)
+    {
+        ImmutableArray<Diagnostic> errors = compilation.GetDiagnostics()
+            .Where(diagnostic => diagnostic.Severity == DiagnosticSeverity.Error)
+            .ToImmutableArray();
+
+        if (errors.Length == 0)
+        {
+            return;
+        }
+
+        string detail = string.Join(
+            System.Environment.NewLine,
+            errors.Select(diagnostic => "  " + diagnostic.Id + ": " + diagnostic.GetMessage(CultureInfo.InvariantCulture)));
+
+        throw new InvalidOperationException(
+            "The test fixture compiled into '" + assemblyName + "' has " + errors.Length
+            + " compiler error(s), so any analyzer result over it is meaningless:"
+            + System.Environment.NewLine + detail);

<Project>

  <!-- Strong-naming + signed/unsigned selection + the InternalsVisibleTo transform (decisions 20/21/35). -->
  <Import Project="$(MSBuildThisFileDirectory)eng/signing.props" />

  <!-- Build version: MAJOR.MINOR source + the once-per-build Day/Time/hash (decisions 15-17/25). The
       generated file is written by eng/version.sh / .ps1 (or the CI leading job) and imported by every
       project, so one build stamps one version. -->
  <Import Project="$(MSBuildThisFileDirectory)eng/version.props" />
  <Import Project="$(MSBuildThisFileDirectory)eng/obj/version.g.props" Condition="Exists('$(MSBuildThisFileDirectory)eng/obj/version.g.props')" />

  <PropertyGroup Label="Target framework and language">
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Label="Continuous integration" Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Label="Warnings and static analysis">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>4thWAIV</Authors>
    <Company>4thWAIV</Company>
    <Product>AgentGuard</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Build version (decisions 15-17/25/33). Day/Time/Combined/hash arrive as one shared value from
       eng/obj/version.g.props (written by the single version step) or from the CI leading job; a bare build
       with none set uses a non-authoritative local fallback. Set AgentGuardChannel=dev for a -pre-release. -->
  <PropertyGroup Label="Build version" Condition="'$(AgentGuardIsAnalyzerProject)' != 'true'">
    <AgentGuardDay Condition="'$(AgentGuardDay)' == ''">0</AgentGuardDay>
    <AgentGuardTime Condition="'$(AgentGuardTime)' == ''">0</AgentGuardTime>
    <AgentGuardCombined Condition="'$(AgentGuardCombined)' == ''">0</AgentGuardCombined>
    <AgentGuardHash Condition="'$(AgentGuardHash)' == ''">local</AgentGuardHash>
    <_AgentGuardPre Condition="'$(AgentGuardChannel)' == 'dev'">-pre-release</_AgentGuardPre>
    <Version>$(AgentGuardMajorMinor).$(AgentGuardCombined)$(_AgentGuardPre)</Version>
    <AssemblyVersion>$(AgentGuardMajorMinor).$(AgentGuardDay).$(AgentGuardTime)</AssemblyVersion>
    <FileVersion>$(AgentGuardMajorMinor).$(AgentGuardDay).$(AgentGuardTime)</FileVersion>
    <InformationalVersion>$(AgentGuardMajorMinor).$(AgentGuardCombined)$(_AgentGuardPre)+$(AgentGuardHash)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <FileDescription>AgentGuard guards critical files from agent changes</FileDescription>
    <Copyright>Copyright © 2026 4thWAIV</Copyright>
  </PropertyGroup>

  <ItemGroup Label="Best-practice analyzer suite">
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Formatting.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" />
    <PackageReference Include="Philips.CodeAnalysis.DuplicateCodeAnalyzer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Label="Source link">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Label="StyleCop configuration">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>

  <ItemGroup Label="Test-only analyzer relaxations" Condition="'$(AgentGuardIsTestProject)' == 'true'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)eng/agentguard-test-analyzer-relaxations.globalconfig" />
  </ItemGroup>

  <ItemGroup Label="Custom analyzer wiring" Condition="'$(AgentGuardIsAnalyzerProject)' != 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)analyzers/AgentGuard.Analyzers/AgentGuard.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>

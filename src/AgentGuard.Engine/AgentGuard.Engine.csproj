<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AgentGuard.Engine</RootNamespace>
    <AssemblyName>AgentGuard.Engine</AssemblyName>
    <PackageId>AgentGuard.Engine</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Versioning" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AgentGuard.Tests" />
  </ItemGroup>

  <!-- The engine consumes every OS/CLR capability through the interfaces it owns in AgentGuard.Abstractions,
       received by constructor injection off ISystemServices at the one composition point. It references only the
       Abstractions assembly (dependencies point one way): it does not reference Boundaries, CrossPlatform, or any
       per-OS assembly. -->
  <ItemGroup>
    <ProjectReference Include="../AgentGuard.Abstractions/AgentGuard.Abstractions.csproj" />
  </ItemGroup>

</Project>

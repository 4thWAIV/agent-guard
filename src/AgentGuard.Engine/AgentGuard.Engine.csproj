<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>AgentGuard.Engine</RootNamespace>
    <AssemblyName>AgentGuard.Engine</AssemblyName>
    <PackageId>AgentGuard.Engine</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Versioning" />
  </ItemGroup>

  <!-- The concrete ISystemServices container and its one SystemServices.Create() composition factory live here and are
       internal (Wall 1). The two legal callers of SystemServices.Create() reach it through these grants
       (single-construction-point, two-walls-stop-the-bypass): the CLI's Program composition method (compiled as
       "guard") and the test SystemServicesBuilder. AG0041 pins both grants to that one invocation — no other Engine
       internal is reachable from either, while every public Engine API stays reachable. The AgentGuard.Tests grant is
       unchanged. Keyless in source; the signing target injects the public key on a signed build. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AgentGuard.Tests" />
    <InternalsVisibleTo Include="guard" />
    <InternalsVisibleTo Include="AgentGuard.TestHelpers" />
  </ItemGroup>

  <!-- Every engine type other than the container consumes OS/CLR capability through the interfaces it owns in
       AgentGuard.Abstractions, received by constructor injection off ISystemServices at the one composition point.
       The Boundaries reference exists for SystemServices.Create() alone: AG0040 permits an Engine call into
       AgentGuard.Boundaries only as one of the four adapter factories and only from that method. -->
  <ItemGroup>
    <ProjectReference Include="../AgentGuard.Abstractions/AgentGuard.Abstractions.csproj" />
    <ProjectReference Include="../AgentGuard.Boundaries/AgentGuard.Boundaries.csproj" />
  </ItemGroup>

  <!-- SystemServices.Create() reaches the OS-uniform adapters through the one CrossPlatformAdapters factory (AG0023)
       and the OS-divergent platform through exactly one per-OS PlatformServices.Create() (AG0029). This shared targets
       file references the AgentGuard.CrossPlatform contract and exactly one per-OS implementation, selected by
       RuntimeIdentifier (falling back to the build-host OS), so SystemServices.Create() stays OS-agnostic. -->
  <Import Project="../AgentGuard.CrossPlatform/PlatformImplementation.targets" />

</Project>

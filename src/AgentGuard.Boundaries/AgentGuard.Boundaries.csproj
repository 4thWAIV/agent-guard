<Project Sdk="Microsoft.NET.Sdk">

  <!-- The OS-uniform boundary layer: the EnvironmentAdapter/ConsoleAdapter owners and the ISignatureService and
       IBuildInfo owners (boundaries-assembly). It references AgentGuard.Abstractions and nothing else. The concrete
       ISystemServices container and the one SystemServices.Create() composition factory now live in
       AgentGuard.Engine, which is why this project no longer selects a per-OS implementation: the four adapters here
       reach neither AgentGuard.CrossPlatform nor any per-OS assembly. The file-op adapters and GuidFactory live in
       AgentGuard.CrossPlatform (owners-live-at-lowest-consumer). -->
  <PropertyGroup>
    <RootNamespace>AgentGuard.Boundaries</RootNamespace>
    <AssemblyName>AgentGuard.Boundaries</AssemblyName>
  </PropertyGroup>

  <!-- BouncyCastle Ed25519 is hidden entirely inside the ISignatureService owner in this assembly
       (signature-verify-behind-isignatureverifier); AG0021 exempts that one owner and no BouncyCastle type
       crosses the interface. The version is centrally managed in Directory.Packages.props. -->
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>

  <!-- The four adapters and their factories are internal (Wall 1). AgentGuard.Engine reaches them through this one
       grant, and only from SystemServices.Create() and only as one of the four permitted factory identities (AG0040).
       This replaces the earlier grants to the CLI ("guard") and the test SystemServicesBuilder: both now reach the
       container through AgentGuard.Engine's own grants instead, so nothing but Engine sees a Boundaries internal.
       Keyless in source; the signing target injects the public key on a signed build. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AgentGuard.Engine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentGuard.Abstractions/AgentGuard.Abstractions.csproj" />
  </ItemGroup>

</Project>

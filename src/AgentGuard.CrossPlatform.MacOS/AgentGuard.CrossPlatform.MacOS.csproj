<Project Sdk="Microsoft.NET.Sdk">

  <!-- macOS per-OS impl assembly. Authors the shared POSIX source under Posix/ (the libc rename binding, the
       IPlatformFileSystem implementation, and the self-building PlatformServices.Create factory). The Linux impl
       link-shares these same files (see AgentGuard.CrossPlatform.Linux.csproj); Windows authors its own. The
       [LibraryImport] source generator for the rename P/Invoke requires unsafe blocks. One of the four
       AgentGuard.CrossPlatform.* libraries the interop/OS-branching analyzers (AG0008/AG0009) exempt. -->
  <PropertyGroup>
    <RootNamespace>AgentGuard.CrossPlatform.MacOS</RootNamespace>
    <AssemblyName>AgentGuard.CrossPlatform.MacOS</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentGuard.Abstractions/AgentGuard.Abstractions.csproj" />
    <ProjectReference Include="../AgentGuard.CrossPlatform/AgentGuard.CrossPlatform.csproj" />
  </ItemGroup>

  <!-- PlatformServices.Create() is internal (platform-create-internal); AgentGuard.Boundaries reaches this one door
       through the grant (AG0029). Keyless in source; the signing target injects the public key on a signed build. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AgentGuard.Boundaries" />
    <!-- The per-OS presence spec tests reach the internal ILocalAuthentication port, LaResult, and MacOsPresenceCheck.Map
         from the one OS-agnostic spec test project, selected onto the macOS impl on the macOS CI leg. -->
    <InternalsVisibleTo Include="AgentGuard.CrossPlatform.Tests" />
  </ItemGroup>

</Project>

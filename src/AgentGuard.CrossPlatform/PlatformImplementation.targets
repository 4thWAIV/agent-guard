<Project>

  <!--
    Shared platform-implementation selection, imported by every project that calls Platform.Create()
    (the engine and the one OS-agnostic spec test project). It references the contract assembly always and
    EXACTLY ONE per-OS implementation, so calling code stays identical and OS-agnostic.

    Selection rule (scan-resolutions #1, Tim approved 2026-08-09): key on the target RuntimeIdentifier, and fall
    back to the build-host OS ONLY when no RID is given. Never key on the build-host OS when a RID is present — a
    cross-build (e.g. publishing win-x64 from macOS) would otherwise ship the wrong library and crash. Paths are
    anchored at $(MSBuildThisFileDirectory) so a single copy of this logic serves every importer regardless of its
    own directory.

    Why $(AgentGuardPlatformRid) and not $(RuntimeIdentifier) directly: on a self-contained cross-RID publish the
    SDK builds this project's *library* references with RuntimeIdentifier undefined (it strips
    TargetFramework;RuntimeIdentifier;SelfContained), so keying straight on $(RuntimeIdentifier) makes restore (RID
    present -> Windows) and the stripped library build (RID absent -> host = macOS) select DIFFERENT per-OS projects,
    and the publish bundles BOTH (or fails NETSDK1004 on a cold tree). The consuming app therefore threads the RID
    down as the AgentGuardPlatformRid global property (see AgentGuard.Cli.csproj's ProjectReference
    AdditionalProperties); that property is NOT in the SDK's strip list, so it survives into the library build and
    restore and every build pass agree on exactly ONE per-OS project. It falls back to $(RuntimeIdentifier) (so a
    direct `dotnet publish -r <rid>` of an importer still works) and then to the build-host OS when neither is set.
  -->
  <PropertyGroup>
    <AgentGuardPlatformRid Condition="'$(AgentGuardPlatformRid)' == ''">$(RuntimeIdentifier)</AgentGuardPlatformRid>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)AgentGuard.CrossPlatform.csproj" />
  </ItemGroup>

  <Choose>
    <When Condition="$(AgentGuardPlatformRid.StartsWith('win')) or ('$(AgentGuardPlatformRid)' == '' and $([MSBuild]::IsOSPlatform('Windows')))">
      <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\AgentGuard.CrossPlatform.Windows\AgentGuard.CrossPlatform.Windows.csproj" />
      </ItemGroup>
    </When>
    <When Condition="$(AgentGuardPlatformRid.StartsWith('linux')) or ('$(AgentGuardPlatformRid)' == '' and $([MSBuild]::IsOSPlatform('Linux')))">
      <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\AgentGuard.CrossPlatform.Linux\AgentGuard.CrossPlatform.Linux.csproj" />
      </ItemGroup>
    </When>
    <When Condition="$(AgentGuardPlatformRid.StartsWith('osx')) or ('$(AgentGuardPlatformRid)' == '' and $([MSBuild]::IsOSPlatform('OSX')))">
      <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\AgentGuard.CrossPlatform.MacOS\AgentGuard.CrossPlatform.MacOS.csproj" />
      </ItemGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <_AgentGuardPlatformImplUnresolved>true</_AgentGuardPlatformImplUnresolved>
      </PropertyGroup>
    </Otherwise>
  </Choose>

  <Target Name="_AgentGuardFailOnUnresolvedPlatformImpl"
          BeforeTargets="ResolveProjectReferences"
          Condition="'$(_AgentGuardPlatformImplUnresolved)' == 'true'">
    <Error Text="No AgentGuard.CrossPlatform per-OS implementation matched AgentGuardPlatformRid '$(AgentGuardPlatformRid)' and the build-host OS; expected a win/linux/osx target." />
  </Target>

</Project>

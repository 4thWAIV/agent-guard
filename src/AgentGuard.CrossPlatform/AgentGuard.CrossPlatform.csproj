<Project Sdk="Microsoft.NET.Sdk">

  <!-- Contract assembly: the platform-capability interfaces and nothing else. ZERO native code lives here; the
       [LibraryImport] bindings live only in the per-OS impl assemblies (.MacOS/.Linux/.Windows), behind these
       locked interfaces. This is one of the four AgentGuard.CrossPlatform.* libraries the interop/OS-branching
       analyzers (AG0008/AG0009) exempt. -->
  <PropertyGroup>
    <RootNamespace>AgentGuard.CrossPlatform</RootNamespace>
    <AssemblyName>AgentGuard.CrossPlatform</AssemblyName>
  </PropertyGroup>

  <!-- The relocated platform interfaces (IPlatformFileSystem/IPlatformServices) now live in
       AgentGuard.Abstractions.Contracts (platform-interfaces-to-abstractions). -->
  <ItemGroup>
    <ProjectReference Include="../AgentGuard.Abstractions/AgentGuard.Abstractions.csproj" />
  </ItemGroup>

  <!-- The owned adapters and the one CrossPlatformAdapters factory stay internal with private constructors (Wall 1).
       AgentGuard.Boundaries reaches the one factory through this grant (boundaries-calls-one-crossplatform-factory);
       the three per-OS implementation assemblies reach it too, so each PlatformServices.Create() wires the same owned adapters
       into its platform file system. Keyless in source; the signing target injects the public key on a signed build
       (decision 35). -->
  <ItemGroup>
    <InternalsVisibleTo Include="AgentGuard.Boundaries" />
    <InternalsVisibleTo Include="AgentGuard.CrossPlatform.MacOS" />
    <InternalsVisibleTo Include="AgentGuard.CrossPlatform.Linux" />
    <InternalsVisibleTo Include="AgentGuard.CrossPlatform.Windows" />
    <!-- The guardrail-1 owner-marker mechanism (guardrail-1-nativespec-convention-test): the OS-agnostic convention test
         reflects over the internal RequiresNativeSpecTestAttribute defined here, which the per-OS owner interfaces carry,
         to discover which owners require a NativeSpec spec test, so the spec-test assembly needs the same internals grant
         the per-OS libs already hold. Keyless in source; the signing target injects the public key on a signed build. -->
    <InternalsVisibleTo Include="AgentGuard.CrossPlatform.Tests" />
  </ItemGroup>

</Project>

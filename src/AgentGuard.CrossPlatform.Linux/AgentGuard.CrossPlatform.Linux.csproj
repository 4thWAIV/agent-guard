<Project Sdk="Microsoft.NET.Sdk">

  <!-- Linux per-OS impl assembly. It carries NO POSIX source of its own: the same libc rename serves both kernels,
       so it <Compile Include=… Link=…>-shares the single authored MacOS POSIX source across project directories —
       ONE source, linked mac -> linux, NOT duplicated and NOT collapsed to a shared base class. A real second copy
       would compile the same type+namespace twice into one assembly (a duplicate-type build error), so the
       compiler itself forbids the copy. The [LibraryImport] source generator requires unsafe blocks. One of the
       four AgentGuard.CrossPlatform.* libraries the interop/OS-branching analyzers (AG0008/AG0009) exempt. -->
  <PropertyGroup>
    <RootNamespace>AgentGuard.CrossPlatform.Linux</RootNamespace>
    <AssemblyName>AgentGuard.CrossPlatform.Linux</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AgentGuard.Abstractions/AgentGuard.Abstractions.csproj" />
    <ProjectReference Include="../AgentGuard.CrossPlatform/AgentGuard.CrossPlatform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../AgentGuard.CrossPlatform.MacOS/Posix/PosixNativeMethods.cs" Link="Posix/PosixNativeMethods.cs" />
    <Compile Include="../AgentGuard.CrossPlatform.MacOS/Posix/PosixFileSystem.cs" Link="Posix/PosixFileSystem.cs" />
    <Compile Include="../AgentGuard.CrossPlatform.MacOS/Posix/PlatformServices.cs" Link="Posix/PlatformServices.cs" />
  </ItemGroup>

  <!-- PlatformServices.Create() is internal (platform-create-internal); AgentGuard.Boundaries reaches this one door
       through the grant (AG0029). Keyless in source; the signing target injects the public key on a signed build. -->
  <ItemGroup>
    <InternalsVisibleTo Include="AgentGuard.Boundaries" />
  </ItemGroup>

</Project>

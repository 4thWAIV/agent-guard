<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one test-only helpers assembly: SystemServicesBuilder (the single approved way a test builds the
       ISystemServices container), the shared copy-on-write overlay, and the fakes. It references
       AgentGuard.Boundaries so SystemServicesBuilder.Real() can call the internal SystemServices.Create() through
       the InternalsVisibleTo grant Boundaries already declares; AgentGuard.Abstractions comes transitively. A
       reference to this assembly from any shipping assembly is a build error (AG0018). It is classified a test
       project so it inherits the shared test relaxations — EXCEPT the documentation rules, re-enabled for this
       one project (GenerateDocumentationFile + the local .editorconfig) so its public builder and fake API carry
       XML docs. -->
  <PropertyGroup>
    <AgentGuardIsTestProject>true</AgentGuardIsTestProject>
    <RootNamespace>AgentGuard.TestHelpers</RootNamespace>
    <AssemblyName>AgentGuard.TestHelpers</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Re-enabled for this one test project (documentation-rules exception): the public builder and fake API
         must carry XML docs. The local .editorconfig turns SA0001/SA1600/CS1591 back on. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/AgentGuard.Boundaries/AgentGuard.Boundaries.csproj" />
  </ItemGroup>

</Project>

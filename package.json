{
  "name": "agent-guard-ts",
  "private": true,
  "type": "module",
  "description": "The TypeScript side of agent-guard. Holds MetaLang \u2014 the language that defines languages \u2014 and the build that will later emit the workflow scripts.",
  "scripts": {
    "check": "bun run ts/metalang/check.ts",
    "render": "bun run ts/metalang/render.ts",
    "examples": "bun run ts/metalang/examples.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ts",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "verify": "bun run typecheck && bun run lint && bun test --coverage",
    "kit": "bun run ts/metalang/kit.ts"
  },
  "dependencies": {
    "js-yaml": "4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/bun": "1.2.14",
    "@types/js-yaml": "4.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0"
  }
}
